{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://balise-skills.example/schemas/marketplace.schema.json",
  "title": "Balise Skills catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "marketplace",
    "categories",
    "tags",
    "skills",
    "collections"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "release", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "release": { "$ref": "#/$defs/semver" },
        "updatedAt": { "$ref": "#/$defs/date" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "planned"] }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "updatedAt",
          "path",
          "summary",
          "category",
          "tags",
          "license",
          "editions",
          "compatibility"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "version": { "$ref": "#/$defs/semver" },
          "updatedAt": { "$ref": "#/$defs/date" },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" },
          "summary": { "type": "string", "minLength": 1 },
          "category": { "$ref": "#/$defs/slug" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/$defs/slug" },
            "uniqueItems": true
          },
          "license": { "const": "Apache-2.0" },
          "editions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/edition" },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "const": "agent-skills" } }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "const": "figma" } }
                },
                "minContains": 0,
                "maxContains": 1
              }
            ]
          },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "adapters", "installTested", "runtimeTested"],
            "properties": {
              "format": { "const": "agent-skills" },
              "adapters": {
                "type": "array",
                "items": { "$ref": "#/$defs/slug" },
                "uniqueItems": true
              },
              "installTested": {
                "type": "array",
                "items": { "$ref": "#/$defs/installEvidence" }
              },
              "runtimeTested": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "manifest": {
            "type": "string",
            "pattern": "^collections/[a-z0-9-]+\\.json$"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "installEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "method", "date"],
      "properties": {
        "harness": { "$ref": "#/$defs/slug" },
        "method": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" }
      }
    },
    "edition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "targets"],
          "properties": {
            "id": { "const": "agent-skills" },
            "path": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" },
            "targets": { "const": ["claude-code", "codex", "cursor"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "targets"],
          "properties": {
            "id": { "const": "figma" },
            "path": {
              "type": "string",
              "pattern": "^figma-skills/[a-z0-9-]+/SKILL\\.md$"
            },
            "targets": { "const": ["figma-agent", "figma-make"] }
          }
        }
      ]
    }
  }
}
